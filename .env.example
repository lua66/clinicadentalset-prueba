# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CRM_OWNER_PASSWORD: Private password for the owner CRM (/crm), validated server-side.
# Leave empty to use the server-hashed default initialization password.
CRM_OWNER_PASSWORD=""

# CRM_SESSION_SECRET: HMAC signing secret for owner CRM sessions.
CRM_SESSION_SECRET=""

# VITE_GA4_MEASUREMENT_ID: Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX).
# Initialized strictly after explicit user cookie consent via Google Consent Mode v2.
VITE_GA4_MEASUREMENT_ID="G-XXXXXXXXXX"
